{
  "name": "@gg-utils/platform-logs-kit",
  "version": "0.2.0",
  "description": "Config-driven platform log UI planning and command orchestration helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build-argv": {
      "types": "./dist/build-argv.d.ts",
      "default": "./dist/build-argv.js"
    },
    "./format-command": {
      "types": "./dist/format-command.d.ts",
      "default": "./dist/format-command.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "default": "./dist/inspect.js"
    },
    "./interactive-menu": {
      "types": "./dist/interactive-menu.d.ts",
      "default": "./dist/interactive-menu.js"
    },
    "./preview-plain": {
      "types": "./dist/preview-plain.d.ts",
      "default": "./dist/preview-plain.js"
    },
    "./repo-root": {
      "types": "./dist/repo-root.d.ts",
      "default": "./dist/repo-root.js"
    },
    "./resolve-log-targets": {
      "types": "./dist/resolve-log-targets.d.ts",
      "default": "./dist/resolve-log-targets.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./ui-entrypoint": {
      "types": "./dist/ui-entrypoint.d.ts",
      "default": "./dist/ui-entrypoint.js"
    },
    "./ui-launcher": {
      "types": "./dist/ui-launcher.d.ts",
      "default": "./dist/ui-launcher.js"
    },
    "./validate-plan": {
      "types": "./dist/validate-plan.d.ts",
      "default": "./dist/validate-plan.js"
    },
    "./package.json": "./package.json",
    "./wizard-model": {
      "types": "./dist/wizard-model.d.ts",
      "default": "./dist/wizard-model.js"
    },
    "./opentui-app": {
      "types": "./dist/opentui-app.d.ts",
      "default": "./dist/opentui-app.js"
    },
    "./ink-app": {
      "types": "./dist/ink-app.d.ts",
      "default": "./dist/ink-app.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@gg-utils/platform-logs-core": "git+https://github.com/gg-utils/platform-logs-core.git#v0.2.0",
    "ink": "6.8.0",
    "react": "19.3.1",
    "react-router": "7.18.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.unit.test.ts\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gg-utils/platform-logs-kit.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
